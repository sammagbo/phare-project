# Service d'authentification pHARe (backend-node). Copier en .env et remplir : le .env reste hors du dépôt.

# Le secret partagé avec l'API (backend) : 32 octets ou plus, le même des deux côtés. Sans lui, ou plus court, aucun
# des deux services ne démarre. Pour en générer un : openssl rand -base64 48
JWT_SECRET=

# Les origines du frontend autorisées par le CORS, séparées par des virgules : les mêmes que pour l'API.
# Sur le réseau local, ajouter http://<IP du PC>:8000
PHARE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Le fichier SQLite des comptes. Vide : backend-node/database.sqlite
PHARE_DB_PATH=

# Le port du service : le frontend l'appelle sur le port 3000
PORT=3000
